[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
speechrecognition = "*"
openai = "*"
python-dotenv = "*"
jinja2 = "*"
flask = "*"
pyrss2gen = "*"
feedparser = "*"
sgmllib3k = "==1.0.0"
certifi = ">=2026.10.23"
cd = "*"
pyyaml = "*"
prompt-toolkit = "*"
pypodcastparser = "*"
werkzeug = ">=3.1.9"
exceptiongroup = "*"
zeroconf = "*"
waitress = "*"
validators = "*"
beartype = "*"
flask-sqlalchemy = "*"
flask-migrate = "*"
Flask-APScheduler = "*"
ffmpeg-python = "*"
litellm = ">=1.106.3,<2"
# LiteLLM requires filelock <4. Version 3.20.3 predates the affected APIs in
# later 3.x releases and includes the earlier symlink fix. Revisit with LiteLLM.
filelock = "==3.20.3"
urllib3 = ">=2.8.0"
multidict = ">=6.9.1"
setuptools = ">=84.1.0"
bleach = "*"
types-bleach = "*"
groq = "*"
async_timeout = "*"
pytest-cov = "*"
flask-cors = "*"
bcrypt = "*"
httpx-aiohttp = "*"
aiohttp = ">=3.14.5"
cryptography = ">=50.0.2"

[dev-packages]
black = ">=26.10.1"
pillow = ">=13.0.0"
pip-audit = "==2.10.1"
mypy = "*"
types-pyyaml = "*"
types-requests = "*"
types-waitress = "*"
pylint = "*"
pytest = "*"
dill = "*"
isort = "*"
types-flask-migrate = "*"
pytest-mock = "*"
watchdog = "*"
requests = "*"
types-flask-cors = "*"

[requires]
python_version = "3.12"
